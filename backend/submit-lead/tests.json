{
  "tests": [
    {
      "name": "Успешная отправка заявки",
      "method": "POST",
      "path": "/",
      "body": {"name": "Иван Иванов", "phone": "+7 900 000-00-00", "comment": "Тест"},
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Ошибка без телефона",
      "method": "POST",
      "path": "/",
      "body": {"name": "Иван"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Загрузка одиночного фото (1x1 PNG)",
      "method": "POST",
      "path": "/",
      "body": {
        "type": "upload-media",
        "filename": "test.png",
        "mime": "image/png",
        "data": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
      },
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Список стройматериалов",
      "method": "POST",
      "path": "/",
      "body": {"type": "materials-list"},
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Добавление без ключа запрещено",
      "method": "POST",
      "path": "/",
      "body": {"type": "materials-add", "name": "Кирпич"},
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    }
  ]
}